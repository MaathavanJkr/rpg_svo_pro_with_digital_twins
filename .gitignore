# Datasets and derived data (never commit)
dataset/

# Large data / digital-twin files
*.bag
*.bag.active
*.zip
*.ply
*.pcd
*.las
*.laz
*.e57
*.vdb

# Python caches
__pycache__/
*.pyc

# Failed runs (kept locally, large retry logs)
runs/_failed/

# Phase 6 per-keyframe event dumps (large; manifests are committed instead)
runs/*/reg_events/

# Phase 8 C++ module build outputs (rebuild with svo_registration/df_cpp/build.sh)
svo_registration/df_cpp/build/
svo_registration/scripts/fyp_df.*.so
