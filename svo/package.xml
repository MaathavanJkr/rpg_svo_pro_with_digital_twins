<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>svo</name>
  <version>0.1.0</version>
  <description>Monocular Visual Odometry</description>
  <maintainer email="forster@ifi.uzh.ch">Christian Forster</maintainer>
  <license>GPLv3</license>
  <author>Christian Forster</author>

  <buildtool_depend>ament_cmake_auto</buildtool_depend>

  <depend>svo_cmake</depend>
  <depend>svo_common</depend>
  <depend>svo_direct</depend>
  <depend>svo_tracker</depend>
  <depend>svo_test_utils</depend>
  <depend>svo_img_align</depend>
  <depend>svo_online_loopclosing</depend>
  <depend>svo_vio_common</depend>
  <depend>rpg_common</depend>
  <depend>vikit_common</depend>
  <depend>vikit_cameras</depend>
  <depend>vikit_solver</depend>
  <depend>minkindr</depend>
  <depend>fast</depend>
  <depend>eigen</depend>
  <depend>libgoogle-glog-dev</depend>
  <depend>geographiclib</depend>
  <depend>yaml-cpp</depend>
  <depend>libopencv-dev</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>eigen_checks</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
