<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>svo_registration</name>
  <version>0.0.0</version>
  <description>The svo_registration package</description>
  <maintainer email="roxane@todo.todo">roxane</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>svo_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-transforms3d</exec_depend>
  <!-- Open3D is required as well: pip install open3d (not packaged for Ubuntu 24.04) -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
