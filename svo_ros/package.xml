<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>svo_ros</name>
  <version>0.1.0</version>
  <description>Visual Odometry - ROS Nodes</description>
  <maintainer email="forster@ifi.uzh.ch">Christian Forster</maintainer>
  <license>GPLv3</license>
  <author>Christian Forster</author>

  <buildtool_depend>ament_cmake_auto</buildtool_depend>

  <depend>svo_cmake</depend>
  <depend>svo</depend>
  <depend>svo_common</depend>
  <depend>svo_msgs</depend>
  <depend>svo_tracker</depend>
  <depend>svo_ceres_backend</depend>
  <depend>svo_online_loopclosing</depend>
  <depend>svo_vio_common</depend>
  <depend>rpg_common</depend>
  <depend>vikit_common</depend>
  <depend>vikit_ros</depend>
  <depend>minkindr</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>ament_index_cpp</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>image_transport</depend>
  <depend>message_filters</depend>
  <depend>tf2_ros</depend>
  <depend>pcl_conversions</depend>
  <depend>libpcl-all-dev</depend>
  <depend>geographiclib</depend>
  <depend>eigen</depend>
  <depend>libgoogle-glog-dev</depend>
  <depend>libgflags-dev</depend>
  <depend>libopencv-dev</depend>
  <depend>yaml-cpp</depend>

  <exec_depend>svo_registration</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>rosbag2_storage_mcap</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
